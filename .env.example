# =====================================================================
# QENGAMESTATION — contoh konfigurasi lingkungan
# Salin berkas ini menjadi ".env" lalu sesuaikan isinya.
#     cp .env.example .env
# Nilai di bawah adalah bawaan aplikasi; tanpa .env sekalipun sistem
# tetap berjalan selama pengaturan MySQL memakai bawaan XAMPP/Laragon.
# =====================================================================

# --- Aplikasi --------------------------------------------------------
APP_NAME="Qengamestation"
APP_ENV=local
# APP_DEBUG=true menampilkan error lengkap (pakai hanya saat berkembang).
# Set false di produksi.
APP_DEBUG=true
# URL dasar termasuk folder public/, tanpa garis miring di akhir.
APP_URL=http://localhost/qengamestation/public
APP_TIMEZONE=Asia/Jakarta

# --- Sesi -------------------------------------------------------------
SESSION_NAME=qs_session
# Ubah true bila situs sudah memakai HTTPS agar cookie hanya dikirim lewat TLS.
SESSION_SECURE=false

# --- Database MySQL / MariaDB ----------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=qengamestation
DB_USER=root
DB_PASS=
